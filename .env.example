# ── TopKaun environment ────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in values to go live.
# With NOTHING set, the app runs in demo mode: sample data + instant mock
# payments, no accounts needed. Add keys to flip each subsystem to live.

# ── Payments: Razorpay (https://dashboard.razorpay.com) ────────────────
# When both are set, real payments turn on automatically.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set this after creating a webhook in the Razorpay dashboard pointing at
# https://YOUR-DOMAIN/api/razorpay/webhook for the `payment.captured` event.
RAZORPAY_WEBHOOK_SECRET=

# ── Database: Supabase (https://supabase.com) ──────────────────────────
# Set URL + SERVICE_ROLE_KEY and the real database turns on automatically
# (replaces the in-memory demo store). Run supabase/schema.sql once first.
# The SERVICE_ROLE_KEY is secret and server-only — never commit it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
